# Python environment & caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Downloaded geographic datasets (re-downloadable from OpenStreetMap)
data/raw/*
!data/raw/.gitkeep

# Generated datasets (arrays, processed vectors, metadata)
data/processed/*
!data/processed/.gitkeep
*.npy
*.npz

# Future model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Temporary outputs (figures are kept; they are small and documented)
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png
!outputs/figures/.gitkeep
*.tmp
.DS_Store
