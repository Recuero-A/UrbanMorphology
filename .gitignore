# Python environment & caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Downloaded geographic datasets (re-downloadable from OpenStreetMap)
data/raw/*
!data/raw/.gitkeep

# Generated datasets (arrays, processed vectors, metadata)
data/processed/*
!data/processed/.gitkeep
*.npy
*.npz

# Future model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Temporary outputs (figures are kept; they are small and documented)
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png
!outputs/figures/.gitkeep
*.tmp
.DS_Store

# Milestone 2 outputs: figures, quality reports and summary tables are small and
# documented, so they are tracked; regenerate with the m2_* scripts.
!outputs/m2/
data/raw/osm_extracts/
!outputs/m2_v1_peru_korea/

# Milestone 3 outputs (figures, histories, metrics; checkpoints stay ignored)
!outputs/m3/
!outputs/m3b/
!outputs/topology/
outputs/topology/eval/*.npy
!outputs/m4/
!outputs/m5/
!outputs/m6/
!outputs/m7/
!outputs/m8/
# Milestone 8: raw cadastral parcels are licensed for local use only (never committed)
data/raw/parcels/
outputs/m8/**/raw/
outputs/m8/parcels/observed_parcel_table.csv
outputs/m8/shape_library/library.npz

# Milestone comparison figures (scripts/compare_milestones.py)
!outputs/compare/
!outputs/m9/
# Milestone 10: figures, metrics, histories (generated samples and exported layouts stay ignored)
!outputs/m10/
outputs/m10/streets/samples/
outputs/m10/procedural_fix/export/
outputs/m10/cities/export/
# Milestone 11: only small metrics/audit JSON are committed; renders, scenes, meshes and city files stay local
# (city files of real tiles may contain licence-restricted cadastral parcels)
!outputs/m11/
outputs/m11/**/*.glb
outputs/m11/**/*.blend
outputs/m11/**/*.blend1
outputs/m11/**/*.npz
outputs/m11/**/*.png
outputs/m11/**/city.json

# Godot editor cache
godot/viewer/.godot/
