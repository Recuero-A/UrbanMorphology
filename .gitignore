# Python environment & caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Downloaded geographic datasets (re-downloadable from OpenStreetMap)
data/raw/*
!data/raw/.gitkeep

# Generated datasets (arrays, processed vectors, metadata)
data/processed/*
!data/processed/.gitkeep
*.npy
*.npz

# Future model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Temporary outputs (figures are kept; they are small and documented)
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png
!outputs/figures/.gitkeep
*.tmp
.DS_Store

# Milestone 2 outputs: figures, quality reports and summary tables are small and
# documented, so they are tracked; regenerate with the m2_* scripts.
!outputs/m2/
data/raw/osm_extracts/
!outputs/m2_v1_peru_korea/

# Milestone 3 outputs (figures, histories, metrics; checkpoints stay ignored)
!outputs/m3/
!outputs/m3b/
!outputs/topology/
outputs/topology/eval/*.npy
!outputs/m4/
!outputs/m5/
!outputs/m6/
